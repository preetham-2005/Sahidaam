# ===================================================================
# SahiDaam Environment Configuration
# ===================================================================

# Core Flask Security
SECRET_KEY=sahidaam-production-secret-key-change-me
FLASK_ENV=development
DEBUG=True

# ===================================================================
# GMAIL SMTP CONFIGURATION (For Real Email OTP Delivery)
# ===================================================================
# 1. Enable 2-Step Verification on your Google Account: https://myaccount.google.com/security
# 2. Generate an App Password under "App passwords": https://myaccount.google.com/apppasswords
# 3. Enter your Gmail and 16-character App Password (without spaces) below:
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USE_SSL=False
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=

# ===================================================================
# GOOGLE SIGN-IN / OAUTH (Optional for Google One-Tap & GSI)
# ===================================================================
# Get these from Google Cloud Console -> APIs & Services -> Credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ===================================================================
# DATABASE
# ===================================================================
# For local development, leave empty to use SQLite automatically.
# On Render / PostgreSQL, set DATABASE_URL=postgresql://user:pass@host/dbname
DATABASE_URL=
